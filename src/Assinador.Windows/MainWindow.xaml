<Window x:Class="Jhonju.Assinador.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Jhonju.Assinador.Windows.Controls"
        Title="Assinador PDF · Jhonju" Width="1180" Height="900" MinWidth="850" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#F3F6FA" FontFamily="Segoe UI" FontSize="13"
        Closing="WindowClosing" Closed="WindowClosed">
  <Grid Margin="22,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="OpenButton" Content="ABRIR PDF" Click="OpenClick" AutomationProperties.AutomationId="OpenPdf"/>
        <Button x:Name="SignButton" Content="ASSINAR" Click="SignClick" IsEnabled="False" Background="#0756A1" Foreground="White" AutomationProperties.AutomationId="SignPdf"/>
      </StackPanel>
      <TextBlock x:Name="FileName" Grid.Column="1" Text="Nenhum PDF selecionado" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#445269"/>
      <TextBlock Grid.Column="2" VerticalAlignment="Center"><Hyperlink Click="AboutClick">Sobre · 0.1.3</Hyperlink></TextBlock>
    </Grid>
    <Grid Grid.Row="1" x:Name="PageTools" IsEnabled="False" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="PreviousButton" Content="◀" Click="PreviousClick" Padding="12,5" ToolTip="Página anterior"/>
      <TextBlock x:Name="PageLabel" Grid.Column="1" Text="Página 0 / 0" VerticalAlignment="Center" Margin="5,0,16,0"/>
      <Button x:Name="NextButton" Grid.Column="2" Content="▶" Click="NextClick" Padding="12,5" ToolTip="Próxima página"/>
      <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Tamanho do selo" VerticalAlignment="Center" Margin="18,0,8,0"/>
        <Slider x:Name="SealSize" Minimum="20" Maximum="95" Value="70" Width="180" VerticalAlignment="Center" ValueChanged="SealSizeChanged" ToolTip="Largura do selo em relação à página"/>
      </StackPanel>
      <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="Zoom" Width="100" SelectedIndex="0" SelectionChanged="ZoomChanged">
          <ComboBoxItem Content="Ajustar"/><ComboBoxItem Content="150%"/><ComboBoxItem Content="200%"/><ComboBoxItem Content="300%"/>
        </ComboBox>
      </StackPanel>
    </Grid>
    <Border Grid.Row="2" Background="#DAE2EC" BorderBrush="#CAD5E1" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
      <Grid>
        <TextBlock x:Name="EmptyHint" Text="Abra um PDF para visualizar o documento e posicionar o selo." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#52617A" FontSize="17" TextWrapping="Wrap" Margin="30"/>
        <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="PreviewSizeChanged">
          <Grid Margin="18">
            <controls:PdfPlacementView x:Name="Preview" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Border>
    <Expander x:Name="Options" Grid.Row="3" Header="Opções da assinatura" Margin="0,12,0,8">
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Motivo (metadado)" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox x:Name="Reason" Grid.Column="1" MaxLength="500"/>
        <TextBlock Text="Local" Grid.Column="2" VerticalAlignment="Center" Margin="18,0,10,0"/>
        <TextBox x:Name="Location" Grid.Column="3" MaxLength="200"/>
      </Grid>
    </Expander>
    <Grid Grid.Row="4">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,0,0,8"/>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Status" Text="Abra um PDF, posicione o selo e clique em Assinar." TextWrapping="Wrap" Foreground="#35445B"/>
        <Button x:Name="DetailsButton" Grid.Column="1" Content="Detalhes" Click="DetailsClick" Visibility="Collapsed" Padding="10,4" Margin="12,0,0,0"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
